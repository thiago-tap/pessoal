---
import type { SiteContent } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const whatsappIcon =
  'M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 1.8a8.2 8.2 0 0 1 6.9 12.5l-.4.6.9 3.3-3.3-.9-.6.3A8.2 8.2 0 1 1 12 3.8zm4.6 9.4c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1s-.6.8-.8 1c-.1.1-.3.2-.5.1-1.4-.7-2.4-1.3-3.3-2.9-.1-.2 0-.3.1-.4l.5-.6c.1-.2.2-.3.1-.5s-.5-1.4-.7-1.9c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.5.1-.7.4-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.9 4.4 3.9 2.5 1 2.5.6 3 .6.5 0 1.5-.6 1.7-1.1.2-.5.2-1 .1-1.1-.1-.1-.3-.2-.5-.3z';
---

<section class="section contact" id="contato">
  <div class="container contact-panel reveal">
    <p class="section-label">{content.contact.label}</p>
    <h2 class="section-title">{content.contact.title}</h2>
    <p class="section-lead">{content.contact.lead}</p>

    <div class="contact-actions">
      <a
        class="btn btn-primary btn-whatsapp"
        href={content.social.contact.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d={whatsappIcon}></path>
        </svg>
        {content.contact.whatsappCta}
      </a>
    </div>

    <p class="networks-label">{content.contact.networksLabel}</p>
    <SocialLinks links={content.social.links} className="contact-socials" />
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p>
        <span class="footer-brand">Thiago Albuquerque de Paula</span>
        <span aria-hidden="true"> · </span>
        {content.location}
      </p>
      <nav class="footer-nav" aria-label={content.contact.footerNavAria}>
        <a href="#sobre">{content.about.label}</a>
        <a href="#projetos">{content.projects.label}</a>
        <a href="#contato">{content.contact.label}</a>
        <a href={content.social.contact.href} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href={content.alternatePath}>{content.alternateLabel}</a>
      </nav>
    </div>
    <p class="footer-note">© <span data-year></span> · thiago.catiteo.com</p>
  </div>
</footer>

<script>
  const yearEl = document.querySelector('[data-year]');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>

<style>
  .contact-panel {
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--border);
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 55%),
      var(--bg-elevated);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 2rem 0 1.5rem;
  }

  .btn-whatsapp :global(.btn-icon) {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  .networks-label {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-footer {
    padding: 2rem 0 2.75rem;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.25rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-brand {
    color: var(--text);
    font-weight: 600;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.65rem;
  }

  .footer-nav a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .footer-note {
    margin: 0;
  }
</style>
