---
import type { SiteContent } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="section contact" id="contato">
  <div class="container contact-panel reveal">
    <p class="section-label">{content.contact.label}</p>
    <h2 class="section-title">{content.contact.title}</h2>
    <p class="section-lead">{content.contact.lead}</p>

    <div class="contact-actions">
      <a
        class="btn btn-primary"
        href={content.social.contact.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {content.contact.whatsappCta}
      </a>
      <a
        class="btn btn-ghost"
        href={content.social.primary.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {content.heroCtaSecondary}
      </a>
      <a class="btn btn-ghost" href={`mailto:${content.email}`}>{content.contact.emailLabel}</a>
    </div>

    <SocialLinks links={content.social.links} className="contact-socials" />
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p>
        <span class="footer-brand">Thiago Albuquerque de Paula</span>
        <span aria-hidden="true"> · </span>
        {content.location}
      </p>
      <nav class="footer-nav" aria-label={content.contact.footerNavAria}>
        <a href="#sobre">{content.about.label}</a>
        <a href="#projetos">{content.projects.label}</a>
        <a href="#contato">{content.contact.label}</a>
        <a href={content.social.contact.href} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href={content.alternatePath}>{content.alternateLabel}</a>
      </nav>
    </div>
    <p class="footer-note">© <span data-year></span> · thiago.catiteo.com</p>
  </div>
</footer>

<script>
  const yearEl = document.querySelector('[data-year]');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>

<style>
  .contact-panel {
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--border);
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 55%),
      var(--bg-elevated);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 2rem 0 1.5rem;
  }

  .site-footer {
    padding: 2rem 0 2.75rem;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.25rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-brand {
    color: var(--text);
    font-weight: 600;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.65rem;
  }

  .footer-nav a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .footer-note {
    margin: 0;
  }
</style>
