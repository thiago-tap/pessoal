---
import type { SiteContent } from '../data/i18n';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<div class="cookie-banner" id="cookie-banner" hidden role="dialog" aria-live="polite" aria-label="Cookies">
  <div class="cookie-banner__inner container">
    <p class="cookie-banner__text">{content.cookie.message}</p>
    <div class="cookie-banner__actions">
      <button type="button" class="btn btn-primary" id="cookie-accept" data-cookie-choice="accepted">
        {content.cookie.accept}
      </button>
      <button type="button" class="btn btn-ghost" id="cookie-reject" data-cookie-choice="rejected">
        {content.cookie.reject}
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    z-index: 60;
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-elevated) 94%, transparent);
    backdrop-filter: blur(14px);
    padding: 1rem 0 calc(1rem + env(safe-area-inset-bottom, 0));
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.28);
  }

  .cookie-banner__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.25rem;
  }

  .cookie-banner__text {
    margin: 0;
    flex: 1 1 18rem;
    max-width: 42rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .cookie-banner__actions :global(.btn) {
    min-height: 44px;
  }
</style>
