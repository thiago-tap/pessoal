---
import type { SiteContent } from '../data/i18n';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="section stack" id="stack">
  <div class="container">
    <div class="reveal">
      <p class="section-label">{content.stack.label}</p>
      <h2 class="section-title">{content.stack.title}</h2>
      <p class="section-lead">{content.stack.lead}</p>
    </div>

    <div class="stack-grid">
      {
        content.stackGroups.map((group, index) => (
          <div class={`stack-group reveal reveal-delay-${(index % 4) + 1}`}>
            <h3>{group.title}</h3>
            <p class="stack-blurb">{group.blurb}</p>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack-grid {
    display: grid;
    gap: 1.75rem;
    margin-top: 3rem;
  }

  .stack-group {
    min-height: 11.5rem;
    display: grid;
    align-content: start;
  }

  .stack-group h3 {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stack-blurb {
    margin: 0 0 1rem;
    max-width: 32rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .stack-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-group li {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease),
      background 0.25s var(--ease);
  }

  .stack-group li:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  @media (min-width: 800px) {
    .stack-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 2.5rem;
    }
  }
</style>
