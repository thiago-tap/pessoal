---
import type { SiteContent } from '../data/i18n';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="section timeline" id="trajetoria">
  <div class="container">
    <div class="reveal">
      <p class="section-label">{content.timeline.label}</p>
      <h2 class="section-title">{content.timeline.title}</h2>
      <p class="section-lead">{content.timeline.lead}</p>
    </div>

    <div class="timeline-layout">
      <ol class="milestones">
        {
          content.timeline.milestones.map((item, index) => (
            <li class={`milestone reveal reveal-delay-${(index % 4) + 1}`}>
              <div class="milestone-year">{item.year}</div>
              <div class="milestone-body">
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <aside class="timeline-aside reveal reveal-delay-2">
        <blockquote>
          <p>{content.timeline.asideQuote}</p>
        </blockquote>
        <p class="timeline-aside-note">{content.timeline.asideNote}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .timeline-layout {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  .milestones {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
    position: relative;
  }

  .milestones::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 1.15s var(--ease);
    will-change: transform;
  }

  .milestones.is-drawn::before {
    transform: scaleY(1);
  }

  .milestone {
    display: grid;
    gap: 0.5rem;
    padding: 0 0 2.25rem 1.5rem;
    position: relative;
  }

  .milestone::before {
    content: '';
    position: absolute;
    left: -0.35rem;
    top: 0.35rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    transform: scale(0.6);
    opacity: 0.45;
    transition:
      transform 0.45s var(--ease),
      opacity 0.45s var(--ease);
  }

  .milestone.is-visible::before,
  .milestone.reveal.is-visible::before {
    transform: scale(1);
    opacity: 1;
  }

  .milestone-year {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .milestone-body h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
  }

  .milestone-body p {
    margin: 0;
    max-width: 40rem;
    color: var(--text-muted);
  }

  .timeline-aside {
    align-self: start;
    padding: 1.35rem 1.25rem;
    border: 1px solid var(--border);
    background:
      linear-gradient(160deg, var(--accent-soft), transparent 55%),
      var(--bg-elevated);
  }

  .timeline-aside blockquote {
    margin: 0;
  }

  .timeline-aside blockquote p {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .timeline-aside-note {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (min-width: 720px) {
    .milestone {
      grid-template-columns: 7.5rem 1fr;
      gap: 1.5rem;
      padding-left: 2rem;
    }
  }

  @media (min-width: 960px) {
    .timeline-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.75fr);
      gap: 2.5rem 3rem;
      align-items: start;
    }

    .timeline-aside {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .milestones::before {
      transform: scaleY(1);
      transition: none;
    }
  }
</style>

<script>
  const milestones = document.querySelector('.milestones');
  if (milestones && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            milestones.classList.add('is-drawn');
            observer.disconnect();
          }
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(milestones);
  } else if (milestones) {
    milestones.classList.add('is-drawn');
  }
</script>
