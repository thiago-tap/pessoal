---
import type { SiteContent } from '../data/i18n';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="section projects" id="projetos">
  <div class="container">
    <div class="reveal">
      <p class="section-label">{content.projects.label}</p>
      <h2 class="section-title">{content.projects.title}</h2>
      <p class="section-lead">{content.projects.lead}</p>
    </div>

    <div class="project-list">
      {
        content.projectItems.map((project, index) => (
          <a
            class={`project reveal reveal-delay-${(index % 4) + 1}`}
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="project-media">
              <img
                class={`project-logo project-logo--${project.logoVariant}`}
                src={project.image}
                alt={`Logo ${project.name}`}
                loading="lazy"
              />
            </div>
            <div class="project-body">
              <div class="project-meta">
                <span class="project-index">0{index + 1}</span>
                <span class="project-link">{content.projects.visit}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-list {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .project {
    display: grid;
    gap: 1rem;
    padding: 0.85rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      border-color 0.35s var(--ease),
      background 0.35s var(--ease);
  }

  .project:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background: var(--accent-soft);
  }

  .project-media {
    display: grid;
    place-items: center;
    min-height: 9.5rem;
    padding: 1.75rem 1.5rem;
    overflow: visible;
    border: 1px solid var(--border);
    background:
      radial-gradient(ellipse 70% 80% at 50% 40%, rgba(224, 168, 74, 0.08), transparent 65%),
      #0c0c0e;
    transition: border-color 0.35s var(--ease);
  }

  :global([data-theme='light']) .project-media {
    background:
      radial-gradient(ellipse 70% 80% at 50% 40%, rgba(184, 121, 31, 0.1), transparent 65%),
      #17171a;
  }

  .project:hover .project-media {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  }

  .project-logo {
    height: auto;
    object-fit: contain;
    transition: transform 0.55s var(--ease);
  }

  .project-logo--wide {
    width: min(72%, 15rem);
    max-height: 4.25rem;
  }

  .project-logo--mark {
    width: auto;
    max-width: min(52%, 7rem);
    max-height: 7rem;
  }

  .project:hover .project-logo {
    transform: scale(1.04);
  }

  .project-body {
    display: grid;
    gap: 0.65rem;
    padding: 0.35rem 0.35rem 0.55rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2rem);
    font-weight: 500;
  }

  .project p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.98rem;
  }

  @media (min-width: 900px) {
    .project-list {
      grid-template-columns: 1fr 1fr;
      gap: 1.35rem;
    }

    .project-media {
      min-height: 10.5rem;
    }
  }
</style>
