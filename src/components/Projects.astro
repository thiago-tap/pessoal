---
import { site } from '../data/site';
---

<section class="section projects" id="projetos">
  <div class="container">
    <div class="reveal">
      <p class="section-label">Projetos</p>
      <h2 class="section-title">Trabalho com cara e propósito</h2>
      <p class="section-lead">
        Produtos próprios, marca e entregas para clientes — selecionados, não uma lista infinita.
      </p>
    </div>

    <div class="project-list">
      {
        site.projects.map((project, index) => (
          <a
            class={`project reveal reveal-delay-${(index % 4) + 1}`}
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="project-media">
              <img
                src={project.image}
                alt={`Preview de ${project.name}`}
                width="1200"
                height="750"
                loading="lazy"
              />
            </div>
            <div class="project-body">
              <div class="project-meta">
                <span class="project-index">0{index + 1}</span>
                <span class="project-link">Visitar</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-list {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .project {
    display: grid;
    gap: 1rem;
    padding: 0.85rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      border-color 0.35s var(--ease),
      background 0.35s var(--ease);
  }

  .project:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background: var(--accent-soft);
  }

  .project-media {
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0c0c0e;
  }

  .project-media img {
    width: 100%;
    aspect-ratio: 21 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.7s var(--ease);
  }

  .project:hover .project-media img {
    transform: scale(1.03);
  }

  .project-body {
    display: grid;
    gap: 0.65rem;
    padding: 0.35rem 0.35rem 0.55rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2rem);
    font-weight: 500;
  }

  .project p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.98rem;
  }

  @media (min-width: 900px) {
    .project-list {
      grid-template-columns: 1fr 1fr;
      gap: 1.35rem;
    }
  }
</style>
