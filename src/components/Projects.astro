---
import { site } from '../data/site';
---

<section class="section projects" id="projetos">
  <div class="container">
    <div class="reveal">
      <p class="section-label">Projetos</p>
      <h2 class="section-title">Trabalho com cara e propósito</h2>
      <p class="section-lead">
        Produtos próprios, marca e entregas para clientes — selecionados, não uma lista infinita.
      </p>
    </div>

    <div class="project-list">
      {
        site.projects.map((project, index) => (
          <a
            class={`project reveal reveal-delay-${(index % 4) + 1}`}
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="project-meta">
              <span class="project-index">0{index + 1}</span>
              <span class="project-link">Visitar</span>
            </div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-list {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }

  .project {
    display: grid;
    gap: 0.85rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid var(--border);
    text-decoration: none;
    transition:
      background 0.35s var(--ease),
      padding-left 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .project:last-child {
    border-bottom: 1px solid var(--border);
  }

  .project:hover {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    padding-left: clamp(1.6rem, 3.4vw, 2.4rem);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    font-weight: 500;
  }

  .project p {
    margin: 0;
    max-width: 44rem;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .project-list {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .project:nth-child(odd) {
      border-right: 1px solid var(--border);
    }
  }
</style>
