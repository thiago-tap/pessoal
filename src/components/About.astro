---
import type { SiteContent } from '../data/i18n';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="section about" id="sobre">
  <div class="container about-grid">
    <div class="about-intro reveal">
      <p class="section-label">{content.about.label}</p>
      <h2 class="section-title">{content.about.title}</h2>
      <p class="section-lead">{content.about.lead}</p>
      <div class="about-photos">
        <figure class="about-photo">
          <img
            src={content.photos.about}
            alt={content.about.photoAlt}
            width="640"
            height="800"
            loading="lazy"
          />
        </figure>
        <figure class="about-photo about-photo--wide">
          <img
            src={content.photos.family}
            alt={content.about.familyAlt}
            width="960"
            height="640"
            loading="lazy"
          />
          <figcaption>{content.about.familyCaption}</figcaption>
        </figure>
      </div>
    </div>

    <div class="about-copy">
      <div class="about-summary reveal" set:html={content.about.summaryHtml} />
      <details class="about-more reveal reveal-delay-1">
        <summary>{content.about.readMore}</summary>
        <div class="about-extra">
          {
            content.about.paragraphsHtml.map((html) => (
              <p set:html={html} />
            ))
          }
        </div>
      </details>
    </div>
  </div>
</section>

<script define:vars={{ birthDate: content.birthDate }}>
  function calcAge(isoDate) {
    const birth = new Date(`${isoDate}T00:00:00`);
    const now = new Date();
    let age = now.getFullYear() - birth.getFullYear();
    const month = now.getMonth() - birth.getMonth();
    if (month < 0 || (month === 0 && now.getDate() < birth.getDate())) {
      age -= 1;
    }
    return age;
  }

  const age = String(calcAge(birthDate));
  document.querySelectorAll('[data-age]').forEach((el) => {
    el.textContent = age;
  });
</script>

<style>
  .about-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .about-intro {
    position: relative;
  }

  .about-photos {
    display: grid;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .about-photo {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .about-photo img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 15%;
    transition: transform 0.8s var(--ease);
  }

  .about-photo--wide img {
    aspect-ratio: 16 / 10;
    object-position: 70% 40%;
  }

  .about-photo:hover img {
    transform: scale(1.03);
  }

  .about-photo figcaption {
    padding: 0.7rem 0.85rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  .about-copy {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
    align-content: start;
  }

  .about-summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .about-summary :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .about-more summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    user-select: none;
  }

  .about-more summary::-webkit-details-marker {
    display: none;
  }

  .about-more summary::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-left: 0.55rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s var(--ease);
  }

  .about-more[open] summary::after {
    transform: rotate(-135deg);
    margin-top: 0.2rem;
  }

  .about-extra {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.85rem;
  }

  .about-extra p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .about-extra :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(18rem, 0.9fr) 1.4fr;
      align-items: start;
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    .about-intro {
      position: sticky;
      top: calc(var(--header-h) + 1.25rem);
    }
  }

  @media (max-width: 899px) {
    .about-photo img {
      object-position: center 12%;
    }

    .about-photo--wide img {
      object-position: 65% 35%;
    }
  }
</style>
