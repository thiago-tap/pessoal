---
import type { SiteContent } from '../data/i18n';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="section about" id="sobre">
  <div class="container about-grid">
    <div class="about-intro reveal">
      <p class="section-label">{content.about.label}</p>
      <h2 class="section-title">{content.about.title}</h2>
      <p class="section-lead">{content.about.lead}</p>
      <div class="about-photos">
        <figure class="about-photo">
          <picture>
            <source
              type="image/webp"
              srcset={content.photos.aboutSrcset.webp}
              sizes="(min-width: 900px) 280px, 45vw"
            />
            <source
              type="image/jpeg"
              srcset={content.photos.aboutSrcset.jpeg}
              sizes="(min-width: 900px) 280px, 45vw"
            />
            <img
              src={content.photos.about}
              alt={content.about.photoAlt}
              width="640"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
        <figure class="about-photo about-photo--wide">
          <picture>
            <source
              type="image/webp"
              srcset={content.photos.familySrcset.webp}
              sizes="(min-width: 900px) 320px, 90vw"
            />
            <source
              type="image/jpeg"
              srcset={content.photos.familySrcset.jpeg}
              sizes="(min-width: 900px) 320px, 90vw"
            />
            <img
              src={content.photos.family}
              alt={content.about.familyAlt}
              width="960"
              height="640"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <figcaption>{content.about.familyCaption}</figcaption>
        </figure>
      </div>
    </div>

    <div class="about-copy">
      <p class="about-summary reveal" set:html={content.about.summaryHtml} />
      <blockquote class="about-quote reveal reveal-delay-1">
        <p>{content.about.pullQuote}</p>
      </blockquote>
      {
        content.about.sections.map((section, index) => (
          <section class={`about-block reveal${index < 3 ? ` reveal-delay-${index + 2}` : ''}`}>
            <h3>{section.heading}</h3>
            <p set:html={section.html} />
          </section>
        ))
      }
    </div>
  </div>
</section>

<script define:vars={{ birthDate: content.birthDate }}>
  function calcAge(isoDate) {
    const birth = new Date(`${isoDate}T00:00:00`);
    const now = new Date();
    let age = now.getFullYear() - birth.getFullYear();
    const month = now.getMonth() - birth.getMonth();
    if (month < 0 || (month === 0 && now.getDate() < birth.getDate())) {
      age -= 1;
    }
    return age;
  }

  const age = String(calcAge(birthDate));
  document.querySelectorAll('[data-age]').forEach((el) => {
    el.textContent = age;
  });
</script>

<style>
  .about-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .about-intro {
    position: relative;
  }

  .about-photos {
    display: grid;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .about-photo {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .about-photo picture {
    display: contents;
  }

  .about-photo img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 15%;
    transition: transform 0.8s var(--ease);
  }

  .about-photo--wide img {
    aspect-ratio: 16 / 10;
    object-position: 70% 40%;
  }

  .about-photo:hover img {
    transform: scale(1.03);
  }

  .about-photo figcaption {
    padding: 0.7rem 0.85rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  .about-copy {
    display: grid;
    gap: 1.45rem;
    max-width: 42rem;
  }

  .about-summary,
  .about-block p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .about-summary {
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .about-quote {
    margin: 0.15rem 0;
    padding: 0.35rem 0 0.35rem 1.1rem;
    border-left: 2px solid var(--accent);
  }

  .about-quote p {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .about-block h3 {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .about-copy :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(18rem, 0.9fr) 1.4fr;
      align-items: start;
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    .about-intro {
      position: sticky;
      top: calc(var(--header-h) + 1.25rem);
    }
  }

  @media (max-width: 899px) {
    .about-photo img {
      object-position: center 12%;
    }

    .about-photo--wide img {
      object-position: 65% 35%;
    }
  }
</style>
