---
import type { SiteContent } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const whatsappIcon =
  'M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 1.8a8.2 8.2 0 0 1 6.9 12.5l-.4.6.9 3.3-3.3-.9-.6.3A8.2 8.2 0 1 1 12 3.8zm4.6 9.4c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1s-.6.8-.8 1c-.1.1-.3.2-.5.1-1.4-.7-2.4-1.3-3.3-2.9-.1-.2 0-.3.1-.4l.5-.6c.1-.2.2-.3.1-.5s-.5-1.4-.7-1.9c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.5.1-.7.4-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.9 4.4 3.9 2.5 1 2.5.6 3 .6.5 0 1.5-.6 1.7-1.1.2-.5.2-1 .1-1.1-.1-.1-.3-.2-.5-.3z';
---

<section class="hero" id="topo">
  <div class="hero-media" aria-hidden="true">
    <picture>
      <source
        media="(min-width: 900px)"
        type="image/webp"
        srcset={content.photos.heroDesktopSrcset.webp}
        sizes="100vw"
      />
      <source
        media="(min-width: 900px)"
        type="image/jpeg"
        srcset={content.photos.heroDesktopSrcset.jpeg}
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset={content.photos.heroMobileSrcset.webp}
        sizes="(max-width: 899px) 640px, 100vw"
      />
      <source
        type="image/jpeg"
        srcset={content.photos.heroMobileSrcset.jpeg}
        sizes="(max-width: 899px) 640px, 100vw"
      />
      <img
        src="/images/thiago-hero-640.jpg"
        alt={content.about.photoAlt}
        width="640"
        height="800"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-content">
    <p class="hero-kicker hero-animate">{content.heroKicker}</p>
    <h1 class="hero-name hero-animate">{content.name}</h1>
    <p class="hero-tagline hero-animate">{content.tagline}</p>
    <p class="hero-support hero-animate">{content.heroSupport}</p>
    <div class="hero-actions hero-animate">
      <a
        class="btn btn-primary btn-whatsapp"
        href={content.social.contact.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d={whatsappIcon}></path>
        </svg>
        {content.heroCtaPrimary}
      </a>
      <a
        class="btn btn-ghost"
        href={content.social.primary.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {content.heroCtaSecondary}
      </a>
      <a class="hero-tertiary" href="#sobre">{content.heroCtaAbout}</a>
    </div>
    <div class="hero-socials hero-animate">
      <SocialLinks links={content.social.heroLinks} className="social-list--hero" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    min-height: calc(100dvh - var(--header-h));
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-media picture,
  .hero-media img {
    width: 100%;
    height: 100%;
  }

  .hero-media img {
    object-fit: cover;
    object-position: center 0%;
    filter: saturate(0.95) contrast(1.04);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        180deg,
        rgba(11, 11, 12, 0.35) 0%,
        rgba(11, 11, 12, 0.15) 28%,
        rgba(11, 11, 12, 0.55) 58%,
        rgba(11, 11, 12, 0.92) 100%
      ),
      var(--hero-overlay);
  }

  :global([data-theme='light']) .hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(247, 242, 234, 0.28) 0%,
        rgba(247, 242, 234, 0.08) 30%,
        rgba(247, 242, 234, 0.55) 60%,
        rgba(247, 242, 234, 0.94) 100%
      ),
      var(--hero-overlay);
  }

  .hero-content {
    padding-block: clamp(3.5rem, 10vw, 6rem);
    max-width: 44rem;
  }

  .hero-kicker {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 14vw, 8rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .hero-tagline {
    margin: 1.25rem 0 0;
    max-width: 28rem;
    color: var(--text);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .hero-support {
    margin: 1rem 0 0;
    max-width: 32rem;
    color: color-mix(in srgb, var(--text) 88%, var(--text-muted));
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.55;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme='light']) .hero-support {
    text-shadow: 0 1px 12px rgba(247, 242, 234, 0.7);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1rem;
    margin-top: 2rem;
  }

  .btn-whatsapp :global(.btn-icon) {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  .hero-tertiary {
    color: color-mix(in srgb, var(--text) 78%, var(--text-muted));
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, var(--accent) 65%, transparent);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    transition:
      color 0.25s var(--ease),
      text-decoration-color 0.25s var(--ease);
  }

  .hero-tertiary:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .hero-socials {
    margin-top: 1.75rem;
  }

  .hero-animate {
    opacity: 0;
    transform: translateY(24px);
    animation: rise 1s var(--ease) forwards;
  }

  /* Keep LCP media fully visible — never opacity-animate the photo */
  .hero-media {
    opacity: 1;
  }

  .hero-animate:nth-child(1) {
    animation-delay: 0.05s;
  }
  .hero-animate:nth-child(2) {
    animation-delay: 0.15s;
  }
  .hero-animate:nth-child(3) {
    animation-delay: 0.28s;
  }
  .hero-animate:nth-child(4) {
    animation-delay: 0.4s;
  }
  .hero-animate:nth-child(5) {
    animation-delay: 0.52s;
  }
  .hero-animate:nth-child(6) {
    animation-delay: 0.64s;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 900px) {
    .hero {
      align-items: center;
    }

    .hero-media img {
      object-position: 72% 42%;
    }

    .hero-overlay {
      background:
        linear-gradient(
          90deg,
          rgba(11, 11, 12, 0.94) 0%,
          rgba(11, 11, 12, 0.72) 38%,
          rgba(11, 11, 12, 0.22) 68%,
          rgba(11, 11, 12, 0.08) 100%
        ),
        linear-gradient(180deg, rgba(11, 11, 12, 0.2) 0%, transparent 40%, rgba(11, 11, 12, 0.45) 100%);
    }

    :global([data-theme='light']) .hero-overlay {
      background:
        linear-gradient(
          90deg,
          rgba(247, 242, 234, 0.96) 0%,
          rgba(247, 242, 234, 0.78) 38%,
          rgba(247, 242, 234, 0.22) 68%,
          rgba(247, 242, 234, 0.06) 100%
        ),
        linear-gradient(180deg, rgba(247, 242, 234, 0.18) 0%, transparent 40%, rgba(247, 242, 234, 0.5) 100%);
    }

    .hero-content {
      margin-right: auto;
      max-width: min(44rem, 48vw);
    }
  }

  @media (max-width: 899px) {
    .hero-media img {
      object-position: center 0%;
    }

    .hero-content {
      padding-bottom: 2.5rem;
    }
  }
</style>
