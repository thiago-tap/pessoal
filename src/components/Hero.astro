---
import type { SiteContent } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="hero" id="topo">
  <div class="hero-media" aria-hidden="true">
    <picture>
      <source media="(min-width: 900px)" srcset={content.photos.heroDesktop} />
      <img
        src={content.photos.hero}
        alt={content.about.photoAlt}
        width="1200"
        height="1500"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-content">
    <p class="hero-kicker hero-animate">{content.heroKicker}</p>
    <h1 class="hero-name hero-animate">{content.name}</h1>
    <p class="hero-tagline hero-animate">{content.tagline}</p>
    <p class="hero-support hero-animate">{content.heroSupport}</p>
    <div class="hero-actions hero-animate">
      <a
        class="btn btn-primary"
        href={content.social.contact.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {content.heroCtaPrimary}
      </a>
      <a
        class="btn btn-ghost"
        href={content.social.primary.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {content.heroCtaSecondary}
      </a>
      <a class="hero-tertiary" href="#sobre">{content.heroCtaAbout}</a>
    </div>
    <div class="hero-socials hero-animate">
      <SocialLinks links={content.social.links} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    min-height: calc(100dvh - var(--header-h));
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-media picture,
  .hero-media img {
    width: 100%;
    height: 100%;
  }

  .hero-media img {
    object-fit: cover;
    object-position: center 0%;
    filter: saturate(0.95) contrast(1.04);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        180deg,
        rgba(11, 11, 12, 0.35) 0%,
        rgba(11, 11, 12, 0.15) 28%,
        rgba(11, 11, 12, 0.55) 58%,
        rgba(11, 11, 12, 0.92) 100%
      ),
      var(--hero-overlay);
  }

  :global([data-theme='light']) .hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(247, 242, 234, 0.28) 0%,
        rgba(247, 242, 234, 0.08) 30%,
        rgba(247, 242, 234, 0.55) 60%,
        rgba(247, 242, 234, 0.94) 100%
      ),
      var(--hero-overlay);
  }

  .hero-content {
    padding-block: clamp(3.5rem, 10vw, 6rem);
    max-width: 44rem;
  }

  .hero-kicker {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 14vw, 8rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .hero-tagline {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    color: var(--text);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .hero-support {
    margin: 1rem 0 0;
    max-width: 32rem;
    color: color-mix(in srgb, var(--text) 82%, var(--text-muted));
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.55;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme='light']) .hero-support {
    text-shadow: 0 1px 12px rgba(247, 242, 234, 0.7);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1rem;
    margin-top: 2rem;
  }

  .hero-tertiary {
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--text-muted) 55%, transparent);
    transition:
      color 0.25s var(--ease),
      text-decoration-color 0.25s var(--ease);
  }

  .hero-tertiary:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .hero-socials {
    margin-top: 1.75rem;
  }

  .hero-animate {
    opacity: 0;
    transform: translateY(24px);
    animation: rise 1s var(--ease) forwards;
  }

  .hero-animate:nth-child(1) {
    animation-delay: 0.05s;
  }
  .hero-animate:nth-child(2) {
    animation-delay: 0.15s;
  }
  .hero-animate:nth-child(3) {
    animation-delay: 0.28s;
  }
  .hero-animate:nth-child(4) {
    animation-delay: 0.4s;
  }
  .hero-animate:nth-child(5) {
    animation-delay: 0.52s;
  }
  .hero-animate:nth-child(6) {
    animation-delay: 0.64s;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 900px) {
    .hero {
      align-items: center;
    }

    .hero-media img {
      object-position: 72% 42%;
    }

    .hero-overlay {
      background:
        linear-gradient(
          90deg,
          rgba(11, 11, 12, 0.94) 0%,
          rgba(11, 11, 12, 0.72) 38%,
          rgba(11, 11, 12, 0.22) 68%,
          rgba(11, 11, 12, 0.08) 100%
        ),
        linear-gradient(180deg, rgba(11, 11, 12, 0.2) 0%, transparent 40%, rgba(11, 11, 12, 0.45) 100%);
    }

    :global([data-theme='light']) .hero-overlay {
      background:
        linear-gradient(
          90deg,
          rgba(247, 242, 234, 0.96) 0%,
          rgba(247, 242, 234, 0.78) 38%,
          rgba(247, 242, 234, 0.22) 68%,
          rgba(247, 242, 234, 0.06) 100%
        ),
        linear-gradient(180deg, rgba(247, 242, 234, 0.18) 0%, transparent 40%, rgba(247, 242, 234, 0.5) 100%);
    }

    .hero-content {
      margin-right: auto;
      max-width: min(44rem, 48vw);
    }
  }

  @media (max-width: 899px) {
    .hero-media img {
      object-position: center 0%;
    }

    .hero-content {
      padding-bottom: 2.5rem;
    }
  }
</style>
