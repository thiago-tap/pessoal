---
import type { SiteContent } from '../data/i18n';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: content.fullName,
  url: content.canonical,
  image: `${content.url}${content.photos.hero}`,
  jobTitle: content.locale === 'en' ? 'Full-Stack Developer' : 'Desenvolvedor Full-Stack',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brasília',
    addressRegion: 'DF',
    addressCountry: 'BR',
  },
  email: content.email,
  sameAs: [
    content.socialHrefs.instagram,
    content.socialHrefs.linkedin,
    content.socialHrefs.github,
    content.socialHrefs.telegram,
    content.socialHrefs.x,
  ],
};

const ogImage = `${content.url}/og.jpg`;
const GTM_ID = 'GTM-NW9SMKQV';
const GA_MEASUREMENT_ID = 'G-P8DWQEWLPE';
---

<!doctype html>
<html lang={content.htmlLang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{content.title}</title>
    <meta name="description" content={content.description} />
    <link rel="canonical" href={content.canonical} />
    <link rel="alternate" hreflang="pt-BR" href={`${content.url}/`} />
    <link rel="alternate" hreflang="en" href={`${content.url}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${content.url}/`} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={content.canonical} />
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={content.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.title} />
    <meta name="twitter:description" content={content.description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/sora-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Prefer smaller hero on mobile for LCP; desktop keeps wide crop -->
    <link
      rel="preload"
      as="image"
      href="/images/thiago-hero-640.webp"
      type="image/webp"
      media="(max-width: 899px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/thiago-hero-desktop-1600.webp"
      type="image/webp"
      media="(min-width: 900px)"
      fetchpriority="high"
    />
    <script is:inline define:vars={{ GTM_ID, GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() {
        window.dataLayer.push(arguments);
      };

      window.__loadSiteAnalytics = function loadSiteAnalytics() {
        if (window.__analyticsLoaded) return;
        window.__analyticsLoaded = true;

        const boot = () => {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', GTM_ID);

          var ga = document.createElement('script');
          ga.async = true;
          ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
          document.head.appendChild(ga);
          window.gtag('js', new Date());
          window.gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
        };

        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => boot(), { timeout: 4000 });
        } else {
          window.setTimeout(boot, 1800);
        }
      };
    </script>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{content.skipLink}</a>
    <slot />
    <CookieBanner content={content} />
    <script>
      const CONSENT_KEY = 'cookie-consent';

      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
        );
        reveals.forEach((el) => observer.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }

      const banner = document.getElementById('cookie-banner');
      const getConsent = () => {
        try {
          return localStorage.getItem(CONSENT_KEY);
        } catch {
          return null;
        }
      };
      const setConsent = (value) => {
        try {
          localStorage.setItem(CONSENT_KEY, value);
        } catch {
          /* ignore */
        }
      };

      const applyConsent = (value) => {
        if (value === 'accepted' && typeof window.__loadSiteAnalytics === 'function') {
          window.__loadSiteAnalytics();
        }
        if (banner) banner.hidden = true;
      };

      const existing = getConsent();
      if (existing === 'accepted' || existing === 'rejected') {
        applyConsent(existing);
      } else if (banner) {
        banner.hidden = false;
      }

      banner?.querySelectorAll('[data-cookie-choice]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const choice = btn.getAttribute('data-cookie-choice');
          if (choice !== 'accepted' && choice !== 'rejected') return;
          setConsent(choice);
          applyConsent(choice);
        });
      });

      const pushEvent = (name, params) => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: name, ...params });
        if (typeof window.gtag === 'function') {
          window.gtag('event', name, params);
        }
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('a');
        if (!link) return;

        if (link.classList.contains('btn-whatsapp') || link.getAttribute('aria-label') === 'WhatsApp') {
          const placement = link.closest('#contato')
            ? 'contact'
            : link.closest('.hero')
              ? 'hero'
              : link.closest('.site-footer')
                ? 'footer'
                : 'social';
          pushEvent('whatsapp_click', { placement, link_url: link.href });
          return;
        }

        if (link.classList.contains('project')) {
          const name = link.querySelector('h3')?.textContent?.trim() || 'project';
          pushEvent('project_click', { project_name: name, link_url: link.href });
        }
      });
    </script>
  </body>
</html>
